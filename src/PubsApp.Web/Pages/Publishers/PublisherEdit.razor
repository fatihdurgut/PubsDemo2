@page "/publishers/edit/{id}"
@inject PublisherService PublisherService
@inject NavigationManager Navigation

<PageTitle>Edit Publisher</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h1>Edit Publisher</h1>
        </div>
    </div>

    <LoadingSpinner IsLoading="@isLoading" />

    <ErrorAlert Message="@errorMessage" OnClose="@(() => errorMessage = null)" />

    @if (!isLoading && model != null)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="mb-3">
                                <label for="publisherName" class="form-label">Publisher Name</label>
                                <InputText id="publisherName" class="form-control" @bind-Value="model.PublisherName" maxlength="40" />
                                <ValidationMessage For="@(() => model.PublisherName)" />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="city" class="form-label">City</label>
                                    <InputText id="city" class="form-control" @bind-Value="model.City" maxlength="20" />
                                    <ValidationMessage For="@(() => model.City)" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="state" class="form-label">State</label>
                                    <InputText id="state" class="form-control" @bind-Value="model.State" maxlength="2" placeholder="CA" />
                                    <small class="form-text text-muted">2-letter state code (e.g., CA, NY, TX)</small>
                                    <ValidationMessage For="@(() => model.State)" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="country" class="form-label">Country</label>
                                <InputText id="country" class="form-control" @bind-Value="model.Country" maxlength="30" />
                                <ValidationMessage For="@(() => model.Country)" />
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    }
                                    <span class="bi bi-save"></span> Save Changes
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                                    <span class="bi bi-x-circle"></span> Cancel
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!isLoading)
    {
        <div class="alert alert-warning">
            <span class="bi bi-exclamation-triangle"></span> Publisher not found.
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private UpdatePublisherDto? model;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPublisher();
    }

    private async Task LoadPublisher()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var publisher = await PublisherService.GetByIdAsync(Id);
            if (publisher != null)
            {
                model = new UpdatePublisherDto
                {
                    PublisherName = publisher.PublisherName,
                    City = publisher.City,
                    State = publisher.State,
                    Country = publisher.Country
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading publisher: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (model == null) return;

        isSaving = true;
        errorMessage = null;

        try
        {
            await PublisherService.UpdateAsync(Id, model);
            Navigation.NavigateTo($"/publishers/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating publisher: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/publishers/{Id}");
    }
}
