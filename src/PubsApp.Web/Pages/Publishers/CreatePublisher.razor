@page "/publishers/create"
@inject PublisherService PublisherService
@inject NavigationManager Navigation

<PageTitle>Create Publisher</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h1>Create New Publisher</h1>
        </div>
    </div>

    <ErrorAlert Message="@errorMessage" OnClose="@(() => errorMessage = null)" />

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label for="publisherId" class="form-label">Publisher ID <span class="text-danger">*</span></label>
                            <InputText id="publisherId" class="form-control" @bind-Value="model.PublisherId" maxlength="4" placeholder="9900" />
                            <small class="form-text text-muted">Exactly 4 digits. Use 9900-9999 for new publishers.</small>
                            <ValidationMessage For="@(() => model.PublisherId)" />
                        </div>

                        <div class="mb-3">
                            <label for="publisherName" class="form-label">Publisher Name</label>
                            <InputText id="publisherName" class="form-control" @bind-Value="model.PublisherName" maxlength="40" />
                            <ValidationMessage For="@(() => model.PublisherName)" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="city" class="form-label">City</label>
                                <InputText id="city" class="form-control" @bind-Value="model.City" maxlength="20" />
                                <ValidationMessage For="@(() => model.City)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="state" class="form-label">State</label>
                                <InputText id="state" class="form-control" @bind-Value="model.State" maxlength="2" placeholder="CA" />
                                <small class="form-text text-muted">2-letter state code (e.g., CA, NY, TX)</small>
                                <ValidationMessage For="@(() => model.State)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="country" class="form-label">Country</label>
                            <InputText id="country" class="form-control" @bind-Value="model.Country" maxlength="30" placeholder="USA" />
                            <ValidationMessage For="@(() => model.Country)" />
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                <span class="bi bi-save"></span> Create Publisher
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="Cancel">
                                <span class="bi bi-x-circle"></span> Cancel
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreatePublisherDto model = new();
    private bool isSaving = false;
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var result = await PublisherService.CreateAsync(model);
            if (result != null)
            {
                Navigation.NavigateTo($"/publishers/{result.PublisherId}");
            }
            else
            {
                errorMessage = "Failed to create publisher.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating publisher: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/publishers");
    }
}
